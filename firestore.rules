rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/config/owner) &&
        get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function orderRateOk() {
      return getAfter(userPath()).data.lo == request.time &&
        (!exists(userPath()) ||
         get(userPath()).data.get('lo', timestamp.date(2000, 1, 1)) < request.time - duration.value(60, 's'));
    }

    function msgRateOk() {
      return getAfter(userPath()).data.lm == request.time &&
        (!exists(userPath()) ||
         get(userPath()).data.get('lm', timestamp.date(2000, 1, 1)) < request.time - duration.value(2, 's'));
    }

    function serviceOk() {
      return request.resource.data['service'] == 'python' ||
        request.resource.data['service'] == 'js' ||
        request.resource.data['service'] == 'fin';
    }

    function viaOk() {
      return request.resource.data.via == 'wa' || request.resource.data.via == 'phone';
    }

    function statusOk() {
      return request.resource.data.status == 'new' ||
        request.resource.data.status == 'ok' ||
        request.resource.data.status == 'no';
    }

    function orderOk() {
      return request.resource.data.keys().hasOnly(['service', 'name', 'wa', 'phone', 'via', 'username', 'pw', 'price', 'shot', 'uid', 'status', 'ts']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.ts == request.time &&
        serviceOk() &&
        viaOk() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.wa is string &&
        request.resource.data.wa.matches('^\\+?[0-9]{8,15}$') &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^\\+?[0-9]{8,15}$') &&
        request.resource.data.username is string &&
        request.resource.data.username.matches('^[A-Za-z0-9_.-]{3,30}$') &&
        request.resource.data.pw is string &&
        request.resource.data.pw.size() < 700 &&
        request.resource.data.shot is string &&
        request.resource.data.shot.size() < 700000 &&
        request.resource.data.price is number;
    }

    match /bootstrap/{code} {
      allow create: if signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        code == 'Abq-nPGbf4r826PNmrZeIndqpJjEMPRS' &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/config/owner);
      allow read, update, delete: if false;
    }

    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'pub']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/bootstrap/$('Abq-nPGbf4r826PNmrZeIndqpJjEMPRS')).data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/config/owner);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['lo', 'lm']);
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.data.keys().hasOnly(['prices', 'pay', 'support']) &&
        request.resource.data.prices.python is number &&
        request.resource.data.prices.js is number &&
        request.resource.data.prices.fin is number &&
        request.resource.data.support is string &&
        request.resource.data.support.size() < 20;
    }

    match /orders/{orderId} {
      allow create: if signedIn() && orderRateOk() && orderOk();
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        statusOk();
      allow delete: if isAdmin();

      match /msgs/{msgId} {
        allow read: if isAdmin() ||
          (signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid);
        allow create: if request.resource.data.keys().hasOnly(['text', 'from', 'ts']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 900 &&
          request.resource.data.ts == request.time &&
          ((isAdmin() && request.resource.data.from == 'a') ||
           (signedIn() && request.resource.data.from == 'c' && msgRateOk() &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid));
        allow update, delete: if false;
      }
    }
  }
}
